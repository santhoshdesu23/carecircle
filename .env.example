# ==========================================
# CareCircle Environment Configuration Template
# ==========================================

# Application
NEXT_PUBLIC_APP_NAME=CareCircle
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
NODE_ENV=development

# Database (MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/
MONGODB_DB=carecircle

# Authentication & Security
AUTH_SECRET=carecircle-super-secret-development-key-32-chars-min!

# Vercel Cron Security Secret (for /api/cron/dispatch-reminders and /api/schedules/handler)
CRON_SECRET=carecircle_cron_secure_token_development

# Administrative Seed Secret (Required in production to run /api/seed)
ADMIN_SEED_SECRET=your_admin_seed_secret_for_production

# Transactional Email (Brevo)
# Obtain your API key from Brevo: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-your_brevo_api_key_here
EMAIL_FROM=CareCircle <notifications@carecircle.app>
